msgid "Operation timed out"
msgstr "Радња је истекла"

#: src/spawn.cc:173
msgid "Operation was cancelled"
msgstr "Радња је отказана"

#: src/spawn.cc:191
#, c-format
msgid "Failed to read from child pipe (%s)"
msgstr "Грешка при читању дете-цевке (%s)"

